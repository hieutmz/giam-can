# Copy file này thành .env.local và điền từ Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chỉ dùng phía server (api/): bật ghi món bằng AI. Không thêm tiền tố VITE_.
ANTHROPIC_API_KEY=
# Email được dùng AI, cách nhau bằng dấu phẩy (bỏ trống = mọi tài khoản)
AI_ALLOWED_EMAILS=
